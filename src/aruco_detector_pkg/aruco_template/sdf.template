<sdf version="1.9">
<model name="{model_name}">
<static>true</static>
<!--
 1 mm offset to avoid z-fighting against the surface the tag sits on.
         The placement pose lives in the world file, not here. 
-->
<pose>0 0 0.001 0 0 0</pose>
<link name="base">
<visual name="base_visual">
<geometry>
<plane>
<normal>0 0 1</normal>
<size>{size_meters} {size_meters}</size>
</plane>
</geometry>
<material>
<diffuse>1 1 1 1</diffuse>
<specular>0.4 0.4 0.4 1</specular>
<pbr>
<metal>
<albedo_map>{texture_uri}</albedo_map>
</metal>
</pbr>
</material>
</visual>
</link>
</model>
</sdf>